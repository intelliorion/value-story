{
  "schema_version": 1,
  "meta": { "title": "Customer Message Routing", "owner": "Portfolio Director", "period": "2026-08",
            "quality_profile": "showcase", "motion": "entry" },
  "initiative": { "id": "int-05", "name": "Customer Message Routing", "sponsor": "Head of Customer Service",
                  "function": "Customer Service", "status": "live" },
  "drivers": { "primary": "operational-adaptability",
               "secondary": ["productivity", "governance-oversight", "standardization-knowledge",
                              "differentiation", "process-cost-efficiency", "overhead-cost-efficiency"] },
  "arc": {
    "problem": {
      "headline": "Every inbound message waited in one undifferentiated queue",
      "detail": "Billing questions, complaints and simple lookups all waited the same amount of time regardless of urgency or the agent skill they needed.",
      "evidence_refs": ["e1"]
    },
    "capability": {
      "headline": "Messages route to the right skill and priority the moment they arrive",
      "detail": "Intent and urgency are inferred at intake and the message is placed in the queue built for it.",
      "evidence_refs": ["e2"],
      "novelty": "reusable"
    },
    "outcome": {
      "headline": "Response times now match what each message actually needs",
      "claim_refs": ["c1", "c2", "c3", "c4", "c5", "c6"]
    },
    "significance": {
      "headline": "The queue now flexes with volume instead of breaking under it",
      "detail": "A seasonal spike no longer means every customer waits longer; it means low-priority messages absorb the slack."
    }
  },
  "claims": [
    { "id": "c1", "driver": "operational-adaptability", "metric": "first response time",
      "unit": "minutes", "tier": "measured", "direction": "decrease",
      "baseline": { "value": 46, "asof": "2026-01", "evidence_ref": "e3" },
      "current":  { "value": 12, "asof": "2026-08", "evidence_ref": "e3" } },
    { "id": "c2", "driver": "productivity", "metric": "messages handled per agent",
      "unit": "messages/shift", "tier": "measured", "direction": "increase",
      "baseline": { "value": 54, "asof": "2026-01", "evidence_ref": "e4" },
      "current":  { "value": 88, "asof": "2026-08", "evidence_ref": "e4" } },
    { "id": "c3", "driver": "governance-oversight", "metric": "messages routed to the wrong skill",
      "unit": "messages/week", "tier": "measured", "direction": "decrease",
      "baseline": { "value": 310, "asof": "2026-01", "evidence_ref": "e5" },
      "current":  { "value": 28,  "asof": "2026-08", "evidence_ref": "e5" } },
    { "id": "c4", "driver": "standardization-knowledge", "tier": "qualitative",
      "statement": "every queue now applies the same routing rules, replacing team-specific triage habits",
      "evidence_ref": "e2" },
    { "id": "c5", "driver": "differentiation", "metric": "customers reporting a same-day resolution",
      "unit": "percent", "tier": "estimated", "direction": "increase",
      "baseline": { "value": 38, "asof": "2026-01" },
      "current":  { "value": 71, "asof": "2026-08" },
      "assumption": { "statement": "assumes the post-contact survey respondents are representative of the full contact volume",
                      "owner": "Portfolio Director" } },
    { "id": "c6", "driver": "overhead-cost-efficiency", "metric": "overflow contractor hours",
      "unit": "hours/month", "tier": "measured", "direction": "decrease",
      "baseline": { "value": 1200, "asof": "2026-01", "evidence_ref": "e6" },
      "current":  { "value": 340,  "asof": "2026-08", "evidence_ref": "e6" } }
  ],
  "evidence": [
    { "ref": "e1", "kind": "doc", "title": "Queue performance review", "author": "CS Analytics",
