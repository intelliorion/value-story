  "initiative": { "id": "int-02", "name": "Claims Backlog Clearance", "sponsor": "Head of Claims Operations",
                  "function": "Operations", "status": "live" },
  "drivers": { "primary": "process-cost-efficiency",
               "secondary": ["productivity", "governance-oversight"] },
  "arc": {
    "problem": {
      "headline": "Backlogged claims sat untouched for weeks",
      "detail": "Adjusters worked oldest-first with no way to separate simple claims from complex ones, so simple claims waited behind complex ones.",
      "evidence_refs": ["e1"]
    },
    "capability": {
      "headline": "Claims sort themselves by complexity on intake",
      "detail": "A classifier reads the claim file at submission and routes it to the queue suited to its complexity.",
      "evidence_refs": ["e2"],
      "novelty": "first-of-kind"
    },
    "outcome": {
      "headline": "The backlog stopped growing and started shrinking",
      "claim_refs": ["c1", "c2", "c3", "c4"]
    },
    "significance": {
      "headline": "Adjuster time now goes to the claims that need it",
      "detail": "Simple claims clear in days, freeing senior adjusters for the complex ones that actually require judgment."
    }
  },
  "claims": [
    { "id": "c1", "driver": "process-cost-efficiency", "metric": "claim cycle time",
      "unit": "days", "tier": "measured", "direction": "decrease",
      "baseline": { "value": 21, "asof": "2026-01", "evidence_ref": "e3" },
      "current":  { "value": 4,  "asof": "2026-07", "evidence_ref": "e3" } },
    { "id": "c2", "driver": "process-cost-efficiency", "metric": "open claims backlog",
